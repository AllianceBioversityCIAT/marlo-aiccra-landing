# ── Local development (fallback when SECRET_NAME is not set) ──

RABBITMQ_URL=amqps://user:password@your-broker.example.com:5671
NOTIFICATION_CLIENT_ID=your-client-id
NOTIFICATION_CLIENT_SECRET=your-client-secret
MARLO_TEAM_EMAIL=team@example.com
EMAIL_QUEUE=your-email-queue
EMAIL_SENDER=noreply@example.com

# ── AWS Lambda container (production) ──
# Only SECRET_NAME is injected into Lambda env vars.
# All credentials above live as JSON keys inside AWS Secrets Manager.

SECRET_NAME=your/secret/path
AWS_REGION=your-aws-region

# S3 or CloudFront base URL for Core Features videos (no trailing slash)
PUBLIC_VIDEOS_BASE_URL=https://your-bucket.s3.your-region.amazonaws.com

# Google Analytics measurement ID (optional override; app has a production default)
# PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Secret JSON shape in AWS Secrets Manager:
# {
#   "RABBITMQ_URL": "...",
#   "NOTIFICATION_CLIENT_ID": "...",
#   "NOTIFICATION_CLIENT_SECRET": "...",
#   "MARLO_TEAM_EMAIL": "...",
#   "EMAIL_QUEUE": "...",
#   "EMAIL_SENDER": "..."
# }

# ── CI/CD deploy (scripts/deploy-ecr.sh) ──
# ECR_REGISTRY=123456789012.dkr.ecr.your-region.amazonaws.com
# ECR_REPO=your-ecr-repo
# LAMBDA_FUNCTION_NAME=your-lambda-function-name
# CLOUDFRONT_DISTRIBUTION_ID=YOUR_CLOUDFRONT_DISTRIBUTION_ID
