# ── Local development (fallback when SECRET_NAME is not set) ──

RABBITMQ_URL=amqps://user:password@your-broker.example.com:5671
NOTIFICATION_CLIENT_ID=your-client-id
NOTIFICATION_CLIENT_SECRET=your-client-secret
MARLO_TEAM_EMAIL=team@example.com
EMAIL_QUEUE=your-email-queue
EMAIL_SENDER=noreply@example.com

# ── AWS Lambda (production) ──
# Only SECRET_NAME is injected into Lambda env vars.
# All credentials above live as JSON keys inside AWS Secrets Manager.

SECRET_NAME=dev/landing/marlo/env
AWS_REGION=us-east-1

# Secret JSON shape in AWS Secrets Manager:
# {
#   "RABBITMQ_URL": "...",
#   "NOTIFICATION_CLIENT_ID": "...",
#   "NOTIFICATION_CLIENT_SECRET": "...",
#   "MARLO_TEAM_EMAIL": "...",
#   "EMAIL_QUEUE": "...",
#   "EMAIL_SENDER": "..."
# }

# ── Deploy scripts (CI/CD) ──
# LAMBDA_FUNCTION_NAME=marlo-landing-dev
# CLOUDFRONT_DISTRIBUTION_ID=E2K1MQOYQJXJLR
# S3_BUCKET=test-landing-marlo.cgiar.org   (static rollback only)
