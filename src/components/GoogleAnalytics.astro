---
import { runtimeEnv } from '../lib/env';

/**
 * GA measurement IDs are public by design (they ship in the page HTML).
 * Env override still supported for non-prod streams.
 * Runs off the main thread via Partytown.
 */
const measurementId =
  import.meta.env.PUBLIC_GA_MEASUREMENT_ID ||
  runtimeEnv('PUBLIC_GA_MEASUREMENT_ID') ||
  'G-LXSWPTGPDR';
---

<script
  type="text/partytown"
  is:inline
  src={`https://www.googletagmanager.com/gtag/js?id=${measurementId}`}
></script>
<script type="text/partytown" is:inline define:vars={{ measurementId }}>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  gtag('js', new Date());
  gtag('config', measurementId);
</script>
