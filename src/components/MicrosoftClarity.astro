---
import { runtimeEnv } from '../lib/env';

/**
 * Clarity project IDs are public by design (they ship in the page HTML).
 * Env override still supported for non-prod projects.
 * Runs off the main thread via Partytown.
 */
const projectId =
  import.meta.env.PUBLIC_CLARITY_PROJECT_ID ||
  runtimeEnv('PUBLIC_CLARITY_PROJECT_ID') ||
  'xmc6amwod9';
---

<script type="text/partytown" is:inline define:vars={{ projectId }}>
  (function (c, l, a, r, i, t, y) {
    c[a] =
      c[a] ||
      function () {
        (c[a].q = c[a].q || []).push(arguments);
      };
    t = l.createElement(r);
    t.async = 1;
    t.src = 'https://www.clarity.ms/tag/' + i;
    y = l.getElementsByTagName(r)[0];
    y.parentNode.insertBefore(t, y);
  })(window, document, 'clarity', 'script', projectId);
</script>
