  { name: 'Carlos Rios', github: 'carios1usb' },
  { name: 'Ana Pantoja', github: 'anamp07' },
  { name: 'Yecksin Mauricio', github: 'yecksin' },
  { name: 'cristianpizociat', github: 'cristianpizociat' },
  { name: 'Grant', github: 'Grant-Lay' },
  { name: 'Cristian Gamboa', github: 'Cristian45' },
  { name: 'BrahianSalazar', github: 'BrahianSalazar' },
  { name: 'Manuel Ricardo Almanzar', github: 'mralmanzar' },
