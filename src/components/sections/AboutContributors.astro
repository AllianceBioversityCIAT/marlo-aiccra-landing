---

<section class="py-16" style="background: #f8f9fa;">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <p class="text-xs font-semibold tracking-widest uppercase mb-3" style="color: #9ca3af;">
      Acknowledgments
    </p>
    <h2 class="text-xl font-bold mb-3" style="color: #111827;">Contributors</h2>
    <p class="text-sm leading-relaxed mb-8 max-w-xl mx-auto" style="color: #6b7280;">
      MARLO is the product of many hands over the years. Thank you to everyone who has contributed
      code, design, and ideas to the platform.
    </p>
    <ul class="flex flex-wrap justify-center gap-x-2 gap-y-2 text-sm" style="color: #4b5563;">
      {
        contributors.map((person, index) => (
          <li class="inline-flex items-center">
            {person.github ? (
              <a
                href={`https://github.com/${person.github}`}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:underline"
                style="color: #4b5563;"
              >
                {person.name}
              </a>
            ) : (
              <span>{person.name}</span>
            )}
            {index < contributors.length - 1 && <span class="ml-2" style="color: #d1d5db;">·</span>}
          </li>
        ))
      }
    </ul>
  </div>
</section>
