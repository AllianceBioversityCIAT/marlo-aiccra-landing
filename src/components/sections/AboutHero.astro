---
import {
  Code2,
  Database,
  Palette,
  ShieldCheck,
  BarChart3,
  Sparkles,
  Users,
  Camera,
} from '@lucide/astro';

const expertise = [
  { icon: Code2, label: 'Software development & platform engineering' },
  { icon: Database, label: 'Data management & MEL' },
  { icon: Palette, label: 'Product & UX/UI design' },
  { icon: ShieldCheck, label: 'Quality assurance & data governance' },
  { icon: BarChart3, label: 'BI & analytics (Power BI)' },
  { icon: Sparkles, label: 'AI-assisted reporting & conversational tools' },
];
---

<section id="about-hero" class="relative overflow-hidden" style="background: #012E4A;">
  <!-- Background dots pattern -->
  <div
    class="absolute inset-0 opacity-10"
    style="background-image: radial-gradient(circle, #ffffff 1px, transparent 1px); background-size: 32px 32px;"
  >
  </div>

  <div class="relative max-w-7xl mx-auto px-6 py-24 lg:py-28">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      <!-- Left: About MARLO -->
      <div class="flex flex-col gap-6 animate-blur-fade-in">
        <p class="text-xs font-semibold tracking-widest uppercase" style="color: #22D3EE;">
          About Us
        </p>
        <h1 class="text-4xl lg:text-5xl font-bold text-white leading-tight text-balance">
          The platform behind
          <em class="not-italic" style="color: #22D3EE; font-style: italic;">CGIAR research</em>
          reporting
        </h1>
        <p class="text-base lg:text-lg leading-relaxed" style="color: rgba(255,255,255,0.8);">
          MARLO — Managing Agricultural Research for Learning and Outcomes — is the platform CGIAR
          programs use to plan, monitor, and report on agricultural research. It brings planning,
          deliverables, indicators, and results into a single shared system, replacing the
          spreadsheets and scattered files that once carried this work.
        </p>
        <p class="text-base leading-relaxed" style="color: rgba(255,255,255,0.7);">
          CGIAR Research Programs bring together scientists from around the world to improve global
          food security, reduce poverty, and better manage natural resources, working with academic,
          civic, and private-sector partners across dozens of countries. That scale creates a real
          challenge: coordinating activities, comparing progress, and sharing knowledge across so
          many teams and institutions is difficult without a common system. MARLO was built to meet
          that challenge, giving programs a shared way to plan, report, and learn from one another.
        </p>
      </div>

      <!-- Right: The team -->
      <div
        class="rounded-3xl p-8 lg:p-10 animate-blur-fade-in-d2"
        style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.15); backdrop-filter: blur(8px);"
      >
        <div class="flex items-center gap-3 mb-5">
          <div
            class="w-11 h-11 rounded-xl flex items-center justify-center shrink-0"
            style="background: rgba(34,211,238,0.15);"
          >
            <Users size={22} color="#22D3EE" />
          </div>
          <h2 class="text-xl lg:text-2xl font-bold text-white">The team behind MARLO</h2>
        </div>

        <p class="text-sm leading-relaxed mb-4" style="color: rgba(255,255,255,0.8);">
          MARLO is built and maintained by the Knowledge and Data Sharing (KDS) team, part of the
          Alliance of Bioversity International and CIAT. The team helps establish the processes that
          capture and share the knowledge generated by research programs, working closely with
          partners and researchers around the world.
        </p>
        <p class="text-sm leading-relaxed mb-6" style="color: rgba(255,255,255,0.7);">
          Day to day, the team keeps MARLO reliable, secure, and useful for the programs that depend
          on it — from maintaining the platform's core systems to building the dashboards, quality
          checks, and AI-assisted tools that help researchers spend less time on paperwork and more
          time on their work.
        </p>

        <!-- Team photo placeholders -->
        <div class="grid grid-cols-3 gap-3 mb-8">
          {
            ['aspect-[4/3]', 'aspect-[4/3]', 'aspect-[4/3]'].map((ratio) => (
              <div
                class:list={[
                  ratio,
                  'rounded-xl flex flex-col items-center justify-center gap-1.5',
                ]}
                style="background: rgba(255,255,255,0.05); border: 1px dashed rgba(255,255,255,0.25);"
              >
                <Camera size={18} color="rgba(255,255,255,0.4)" />
                <span class="text-[10px]" style="color: rgba(255,255,255,0.4);">
                  Team photo
                </span>
              </div>
            ))
          }
        </div>

        <h3
          class="text-xs font-semibold tracking-widest uppercase mb-4"
          style="color: #22D3EE;"
        >
          Areas of expertise
        </h3>
        <ul class="flex flex-wrap gap-2 mb-6">
          {
            expertise.map(({ icon: Icon, label }) => (
              <li
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium"
                style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.18); color: rgba(255,255,255,0.9);"
              >
                <Icon size={13} color="#60A5FA" />
                {label}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
