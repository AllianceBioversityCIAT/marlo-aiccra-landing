---
import { Code2, Database, Palette, ShieldCheck, BarChart3, Sparkles, Users } from '@lucide/astro';

const expertise = [
  { icon: Code2, label: 'Software development & platform engineering' },
  { icon: Database, label: 'Data management & MEL' },
  { icon: Palette, label: 'Product & UX/UI design' },
  { icon: ShieldCheck, label: 'Quality assurance & data governance' },
  { icon: BarChart3, label: 'BI & analytics (Power BI)' },
  { icon: Sparkles, label: 'AI-assisted synthesis & conversational tools' },
];
---

<section id="about-hero" class="relative overflow-hidden" style="background: #012E4A;">
  <!-- Background dots pattern -->
  <div
    class="absolute inset-0 opacity-10"
    style="background-image: radial-gradient(circle, #ffffff 1px, transparent 1px); background-size: 32px 32px;"
  >
  </div>

  <div class="relative max-w-7xl mx-auto px-6 py-24 lg:py-28">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      <!-- Left: About MARLO -->
      <div class="flex flex-col gap-6 animate-blur-fade-in">
        <p class="text-xs font-semibold tracking-widest uppercase" style="color: #22D3EE;">
          About Us
        </p>
        <h1 class="text-4xl lg:text-5xl font-bold text-white leading-tight text-balance">
          The platform behind
          <em class="not-italic" style="color: #22D3EE; font-style: italic;">CGIAR research</em>
          reporting
        </h1>
        <p class="text-sm lg:text-base font-semibold" style="color: #22D3EE;">
          Supporting research planning, monitoring, and reporting
        </p>
        <p class="text-base lg:text-lg leading-relaxed" style="color: rgba(255,255,255,0.8);">
          MARLO (Managing Agricultural Research for Learning and Outcomes) is a digital platform
          developed and maintained by the Innovation and Business Development (IBD) Unit to support
          research and development programs in planning, monitoring, and reporting their work.
        </p>
        <p class="text-base leading-relaxed" style="color: rgba(255,255,255,0.7);">
          The platform brings together key information such as plans, deliverables, indicators,
          outputs, and results in one place, helping teams manage information more consistently and
          efficiently throughout the project lifecycle. <br />
          <br /> Over time, MARLO has evolved through collaboration with researchers, program teams, and
          partners, adapting to different reporting and learning needs. Today, it supports organizations
          seeking a structured approach to track progress, document achievements, and make information
          more accessible for decision-making and knowledge sharing.
        </p>
      </div>

      <!-- Right: The team -->
      <div
        class="rounded-3xl p-8 lg:p-10 animate-blur-fade-in-d2"
        style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.15); backdrop-filter: blur(8px);"
      >
        <div class="flex items-center gap-3 mb-5">
          <div
            class="w-11 h-11 rounded-xl flex items-center justify-center shrink-0"
            style="background: rgba(34,211,238,0.15);"
          >
            <Users size={22} color="#22D3EE" />
          </div>
          <h2 class="text-xl lg:text-2xl font-bold text-white">The team behind MARLO</h2>
        </div>

        <p class="text-sm leading-relaxed mb-4" style="color: rgba(255,255,255,0.8);">
          MARLO is supported by the Innovation & Business Development (IBD) Unit at the Alliance of
          Bioversity International and CIAT. The team works alongside research programs and partners
          to understand evolving needs and support the management of information, reporting
          processes, and knowledge sharing activities.
        </p>
        <p class="text-sm leading-relaxed mb-6" style="color: rgba(255,255,255,0.7);">
          The IBD team brings together expertise in product management, business analysis, software
          development, data solutions, and user experience design. Through ongoing collaboration
          with researchers and program teams, they help ensure that MARLO continues to evolve and
          respond to the changing requirements of research and development initiatives.
        </p>

        <h3 class="text-xs font-semibold tracking-widest uppercase mb-4" style="color: #22D3EE;">
          Areas of expertise
        </h3>
        <ul class="flex flex-wrap gap-2 mb-6">
          {
            expertise.map(({ icon: Icon, label }) => (
              <li
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium"
                style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.18); color: rgba(255,255,255,0.9);"
              >
                <Icon size={13} color="#60A5FA" />
                {label}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
