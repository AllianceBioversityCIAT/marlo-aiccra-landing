---
import { ChevronDown, ArrowRight, MessageSquare } from '@lucide/astro';
import { extendedFaqs as faqs } from '../../data/faqs';
---

<section style="background: #f3f4f6;" class="py-24">
  <div class="max-w-3xl mx-auto px-6">
    <!-- Header -->
    <div class="text-center mb-14">
      <p class="text-xs font-semibold tracking-widest uppercase mb-3" style="color: #60A5FA;">
        FAQs
      </p>
      <h1 class="text-3xl lg:text-4xl font-bold mb-4" style="color: #111827;">
        Frequently Asked Questions
      </h1>
      <p class="text-sm leading-relaxed max-w-xl mx-auto" style="color: #6b7280;">
        Everything you need to know about MARLO. Can't find the answer you're looking for? Reach out
        to our team.
      </p>
    </div>

    <!-- FAQ items -->
    <div class="flex flex-col gap-4 mb-14">
      {
        faqs.map(({ question, answer }) => (
          <details
            class="group bg-white rounded-2xl overflow-hidden"
            style="border: 1px solid #e5e7eb;"
          >
            <summary
              class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer select-none list-none"
              style="color: #111827;"
            >
              <span class="text-sm font-semibold">{question}</span>
              <ChevronDown
                size={16}
                color="#9ca3af"
                class="shrink-0 transition-transform group-open:rotate-180"
              />
            </summary>
            <div class="px-6 pb-5">
              <p class="text-sm leading-relaxed" style="color: #6b7280;">
                {answer}
              </p>
            </div>
          </details>
        ))
      }
    </div>

    <!-- CTA -->
    <div
      class="rounded-2xl p-8 text-center flex flex-col items-center gap-4"
      style="background: white; border: 1px solid #e5e7eb;"
    >
      <div
        class="flex items-center justify-center w-11 h-11 rounded-xl"
        style="background: rgba(13,148,136,0.1);"
      >
        <MessageSquare size={20} style="color: #0d9488;" />
      </div>
      <div>
        <p class="text-base font-bold mb-1" style="color: #111827;">Still have questions?</p>
        <p class="text-sm" style="color: #6b7280;">
          Can't find what you're looking for? Our team is happy to help.
        </p>
      </div>
      <a
        href="/contact"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-sm font-semibold text-white transition-all"
        style="background-color: #2563eb;"
        onmouseover="this.style.backgroundColor='#1d4ed8'"
        onmouseout="this.style.backgroundColor='#2563eb'"
      >
        Contact us
        <ArrowRight size={15} />
      </a>
    </div>
  </div>
</section>
