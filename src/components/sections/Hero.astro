---
import { ArrowRight, Zap } from '@lucide/astro';
---

<section
  id="home"
  class="relative min-h-[calc(85vh-64px)] flex flex-col justify-center overflow-hidden"
  style="background: #012E4A;"
>
  <!-- Background dots pattern -->
  <div
    class="absolute inset-0 opacity-10"
    style="background-image: radial-gradient(circle, #ffffff 1px, transparent 1px); background-size: 32px 32px;"
  >
  </div>

  <div class="relative max-w-7xl mx-auto px-6 py-24 lg:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <!-- Left content -->
      <div class="flex flex-col gap-8">
        <!-- Headline -->
        <h1
          class="text-4xl lg:text-5xl xl:text-6xl font-bold text-white leading-tight animate-blur-fade-in text-balance"
        >
          Transform reporting into a
          <em class="not-italic" style="color: #22D3EE; font-style: italic;">strategic asset</em>
        </h1>

        <!-- Description -->
        <p
          class="text-base lg:text-lg leading-relaxed animate-blur-fade-in-d1"
          style="color: rgba(255,255,255,0.75);"
        >
          MARLO (Managing Agricultural Research for Learning and Outcomes) is a structured reporting
          and performance management platform designed for complex programs. It helps teams improve
          data quality, life-cycle reporting processes, and turn data into actionable insights for
          better decision-making.
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap gap-4 animate-blur-fade-in-d2">
          <a
            href="/contact"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-lg text-sm font-semibold text-white transition-all"
            style="background-color: #0EA5E9; border: 2px solid #0EA5E9;"
            onmouseover="this.style.backgroundColor='#1d4ed8'; this.style.borderColor='#1d4ed8';"
            onmouseout="this.style.backgroundColor='#0EA5E9'; this.style.borderColor='#0EA5E9';"
          >
            Request a Demo
            <ArrowRight size={16} />
          </a>
        </div>
      </div>

      <!-- Right: Dashboard illustration -->
      <div class="flex justify-center lg:justify-end items-center animate-blur-fade-in-d3">
        <div class="relative w-full max-w-[600px] p-6 hero-float">
          <!-- Main dashboard image -->
          <div
            class="rounded-3xl overflow-hidden shadow-2xl"
            style="border: 1px solid rgba(255,255,255,0.2);"
          >
            <img
              src="/images/dashboard.webp"
              alt="MARLO Reporting Dashboard"
              class="w-full h-auto block"
              loading="eager"
            />
          </div>

          <!-- Floating card 1: Report submitted (top-right) -->
          <div
            class="absolute -top-2 -right-2 rounded-2xl px-4 py-3 w-52 shadow-lg hero-float-card-1"
            style="background: rgba(255,255,255,0.95); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.8);"
          >
            <div class="flex items-center gap-2 mb-1.5">
              <div
                class="w-6 h-6 rounded-lg flex items-center justify-center"
                style="background: #EAFAF1;"
              >
                <Zap size={12} color="#1A7A4A" />
              </div>
              <span class="text-[11px] font-semibold" style="color: #111827;">Report Submitted</span
              >
            </div>
            <p class="text-[10px] leading-snug" style="color: #6b7280;">
              Q3 progress report validated and submitted by Program B
            </p>
            <div class="mt-2 text-[10px] font-semibold" style="color: #1A7A4A;">
              Status: Approved ↑
            </div>
          </div>

          <!-- Floating card 2: Report status (bottom-left) -->
          <div
            class="absolute -bottom-2 -left-2 rounded-2xl px-4 py-3 w-48 shadow-lg hero-float-card-2"
            style="background: rgba(255,255,255,0.95); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.8);"
          >
            <div
              class="text-[10px] font-semibold mb-2 tracking-wide uppercase"
              style="color: #9ca3af;"
            >
              Report Status
            </div>
            <div class="flex flex-col gap-1.5">
              {
                [
                  { label: 'Submitted', count: 6, color: '#1A7A4A' },
                  { label: 'In Review', count: 2, color: '#9A7D0A' },
                ].map(({ label, count, color }) => (
                  <div class="flex items-center justify-between">
                    <span class="text-[11px]" style="color: #374151;">
                      {label}
                    </span>
                    <span class="text-[11px] font-bold" style={`color: ${color};`}>
                      {count}
                    </span>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- Floating card 3: Country badges (left-middle) -->
          <div
            class="absolute top-1/2 -left-4 rounded-xl px-3 py-2 shadow-lg hero-float-card-3"
            style="background: rgba(255,255,255,0.95); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.8);"
          >
            <div class="text-[10px] font-semibold mb-1.5" style="color: #9ca3af;">Countries</div>
            <div class="flex gap-1">
              {
                [
                  { code: 'ET', label: 'Ethiopia' },
                  { code: 'GH', label: 'Ghana' },
                  { code: 'SN', label: 'Senegal' },
                  { code: 'ML', label: 'Mali' },
                  { code: 'KE', label: 'Kenya' },
                  { code: 'NG', label: 'Nigeria' },
                ].map(({ code, label }) => (
                  <span
                    class="w-6 h-6 rounded-full flex items-center justify-center text-white font-bold overflow-hidden"
                    style={`font-size: 0.5rem; text-shadow: 0 1px 2px rgba(0,0,0,0.8); background-image: linear-gradient(rgba(0,0,0,0.35), rgba(0,0,0,0.35)), url(https://flagsapi.com/${code}/flat/64.png); background-size: 160% 160%; background-position: center; background-repeat: no-repeat;`}
                    title={label}
                    aria-label={label}
                  >
                    {code}
                  </span>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
