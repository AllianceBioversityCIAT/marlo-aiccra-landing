---
import MountainTimeline from './MountainTimeline.tsx';
---

<section id="about-marlo" class="py-24" style="background: #f8f9fa;">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-12">
      <p class="text-xs font-semibold tracking-widest uppercase mb-3" style="color: #60A5FA;">
        Our History
      </p>
      <h2 class="text-3xl lg:text-4xl font-bold" style="color: #111827;">The Story of MARLO</h2>
      <p class="mt-3 max-w-xl mx-auto text-sm" style="color: #6b7280;">
        From a planning tool to a strategic research management ecosystem
      </p>
    </div>

    <MountainTimeline client:visible />
  </div>
</section>
