---
const partners = [
  { name: 'Alliance of Bioversity & CIAT', src: '/logos/alliance.png' },
  { name: 'World Bank', src: '/logos/world-bank.png' },
  { name: 'IFPRI', src: '/logos/ifpri.svg' },
  { name: 'ILRI', src: '/logos/ilri.svg', width: '80px' },
  { name: 'CIMMYT', src: '/logos/cimmyt.png', width: '200px' },
  { name: 'IITA', src: '/logos/iita.png' },
  { name: 'Columbia University', src: '/logos/columbia-university.png', width: '180px' },
  { name: 'University of Vermont', src: '/logos/university-of-vermont.png', width: '160px' },
  { name: 'CCAFS', src: '/logos/ccafs.png', width: '80px' },
  {
    name: 'Wageningen University & Research',
    src: '/logos/wageningen-university.png',
    width: '180px',
  },
  { name: 'Utrecht University', src: '/logos/utrecht-university.png', width: '150px' },
  { name: 'University of Oxford', src: '/logos/university-of-oxford.png', width: '180px' },
  { name: 'University of Leeds', src: '/logos/university-of-leeds.png', width: '160px' },
];
// Duplicate for seamless infinite loop
const loopItems = [...partners, ...partners];
---

<section class="bg-white pt-12 pb-6" style="border-bottom: 1px solid #e5e7eb;">
  <div class="max-w-7xl mx-auto px-6 flex flex-col gap-8">
    <div class="flex flex-col lg:flex-row items-center gap-10">
      <!-- Left label -->
      <p
        class="shrink-0 text-center lg:text-left lg:w-44 text-sm font-semibold leading-snug tracking-widest uppercase"
        style="color: #0d9488;"
      >
        Partners That Have Trusted MARLO*
      </p>

      <!-- Carousel. w-full + min-w-0 are required: the parent is `flex-col
           items-center` below `lg`, so without them this item is sized to the
           track's max-content width and pushes the page into horizontal scroll. -->
      <div class="carousel-wrapper w-full min-w-0 flex-1 overflow-hidden relative">
        <!-- Fade edges -->
        <div class="fade-edge fade-left pointer-events-none absolute inset-y-0 left-0 z-10"></div>
        <div class="fade-edge fade-right pointer-events-none absolute inset-y-0 right-0 z-10"></div>

        <div class="marquee-track flex items-center">
          {
            loopItems.map(({ name, src, width = 'auto' }) => (
              <div class="partner-logo-item shrink-0 flex items-center justify-center pr-8 sm:pr-14">
                <img
                  src={src}
                  alt={name}
                  class="partner-logo object-contain"
                  style={`width: ${width};`}
                />
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Disclaimer -->
    <p class="text-center text-[10px]" style="color: #9ca3af;">
      *These organizations have partnered with or used MARLO in the past; not all are currently
      active users.
    </p>
  </div>
</section>

<style>
  .carousel-wrapper {
    cursor: default;
  }

  .marquee-track {
    will-change: transform;
  }

  /* Narrow viewports: 80px fades would eat almost half of a 360px screen. */
  .fade-edge {
    width: 40px;
  }

  .fade-left {
    background: linear-gradient(to right, white, transparent);
  }

  .fade-right {
    background: linear-gradient(to left, white, transparent);
  }

  @media (min-width: 640px) {
    .fade-edge {
      width: 80px;
    }
  }

  .partner-logo {
    height: 50px;
    filter: grayscale(100%);
    opacity: 0.6;
    transition:
      filter 0.35s ease,
      opacity 0.35s ease;
  }

  .partner-logo-item:hover .partner-logo {
    filter: grayscale(0%);
    opacity: 1;
  }
</style>

<script>
  const wrapper = document.querySelector<HTMLElement>('.carousel-wrapper');
  const track = document.querySelector<HTMLElement>('.marquee-track');

  if (wrapper && track) {
    const BASE_SPEED = 60; // px/s
    const HOVER_SPEED = 18; // px/s — noticeably slower on hover
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    let speed = BASE_SPEED;
    let x = 0;
    let halfWidth = 0;
    let lastTime: number | null = null;
    let frame: number | null = null;
    let onScreen = true;

    wrapper.addEventListener('mouseenter', () => {
      speed = HOVER_SPEED;
    });

    wrapper.addEventListener('mouseleave', () => {
      speed = BASE_SPEED;
    });

    // The track holds the partner list twice, so translating by exactly half of
    // it lands on a visually identical frame. Remeasure on every layout change
    // (late-loading logos, viewport resize, orientation change) — a stale
    // halfWidth makes the loop jump or drift off-screen.
    const measure = () => {
      halfWidth = track.scrollWidth / 2;
      if (halfWidth > 0) x = x % halfWidth;
    };

    const tick = (timestamp: number) => {
      if (lastTime === null) lastTime = timestamp;
      x -= (speed * (timestamp - lastTime)) / 1000;
      lastTime = timestamp;

      if (x <= -halfWidth) x += halfWidth;

      track.style.transform = `translateX(${x}px)`;
      frame = requestAnimationFrame(tick);
    };

    const stop = () => {
      if (frame !== null) cancelAnimationFrame(frame);
      frame = null;
      lastTime = null;
    };

    const sync = () => {
      stop();
      measure();

      if (reduceMotion.matches) {
        x = 0;
        track.style.transform = 'translateX(0px)';
        return;
      }

      // No point animating a zero-width track or an off-screen section.
      if (halfWidth > 0 && onScreen) frame = requestAnimationFrame(tick);
    };

    if (typeof ResizeObserver === 'undefined') {
      window.addEventListener('resize', sync);
    } else {
      let firstCallback = true;
      new ResizeObserver(() => {
        // ResizeObserver fires once on observe(); the initial sync below covers it.
        if (firstCallback) firstCallback = false;
        else sync();
      }).observe(track);
    }

    reduceMotion.addEventListener('change', sync);

    new IntersectionObserver(
      ([entry]) => {
        onScreen = entry.isIntersecting;
        sync();
      },
      { threshold: 0 }
    ).observe(wrapper);

    if (document.readyState === 'complete') sync();
    else window.addEventListener('load', sync);
  }
</script>
