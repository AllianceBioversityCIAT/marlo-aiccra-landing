---
import { Quote } from '@lucide/astro';

const featured = [
  {
    quote:
      'They are incredibly talented in data management and visualization, and so friendly and easy to work with! We spent many hours debating on the new innovation catalogue, in terms of data fields in MARLO and output options, and they made that a very comfortable process. MARLO is a simple reporting management system that is easy to navigate, and allows for reflection in data platforms. It collects both quantitative and qualitative data, and can be organized across multiple sections, as is done within the AICCRA program.',
    name: 'Hanna Ewell',
    image: '/testimonials/hanna-ewell.webp',
    color: '#2563eb',
    bg: 'rgba(37,99,235,0.05)',
    border: 'rgba(37,99,235,0.1)',
  },
  {
    quote:
      "MARLO has fundamentally transformed the way our team collaborates and delivers on AICCRA's mission. More than a data management tool, it fosters transparency, accountability, and cohesion across our clusters. By centralizing data and aligning reporting systems, it empowers us to make evidence-based decisions and track progress toward our climate-smart agriculture goals. Its intuitive design and adaptability have made it an essential tool for planning, monitoring, and reporting — and its success is a testament to the commitment and creativity of the people behind it.",
    name: 'Robert Zougmore',
    image: '/testimonials/robert-zougmore.webp',
    color: '#0d9488',
    bg: 'rgba(13,148,136,0.05)',
    border: 'rgba(13,148,136,0.1)',
  },
  {
    quote:
      'I appreciate the products and platforms developed by the IBD team because they have made my work easier, particularly in program management. The tools help us organize and access information more effectively, while also supporting new areas of work and collaboration. As our programs evolve, having platforms that can adapt to different needs and provide useful insights has been extremely valuable for both planning and implementation.',
    name: 'Angelica Barlis',
    image: '/testimonials/angelica-barlis.webp',
    color: '#7c3aed',
    bg: 'rgba(124,58,237,0.05)',
    border: 'rgba(124,58,237,0.1)',
  },
];

const initials = (name: string) =>
  name
    .split(' ')
    .map((part) => part[0])
    .join('')
    .toUpperCase();
---

<section id="testimonials" class="bg-white py-24">
  <div class="max-w-7xl mx-auto px-6">
    <!-- Header -->
    <div class="text-center mb-12">
      <p class="text-xs font-semibold tracking-widest uppercase mb-3" style="color: #60A5FA;">
        Testimonials
      </p>
      <h2 class="text-3xl lg:text-4xl font-bold" style="color: #111827;">
        Supporting teams in complex environments
      </h2>
    </div>

    <!-- Featured testimonials -->
    <div class="flex flex-col gap-6">
      {
        featured.map(({ quote, name, image, color, bg, border }) => (
          <div
            class="rounded-2xl p-8 lg:p-10 flex flex-col gap-6"
            style={`background: ${bg}; border: 1px solid ${border};`}
          >
            <Quote size={32} color={color} style="opacity: 0.25;" />
            <p class="text-base lg:text-lg leading-relaxed font-medium" style="color: #111827;">
              "{quote}"
            </p>
            <div class="flex items-center gap-3">
              {image ? (
                <img
                  src={image}
                  alt={name}
                  class="w-12 h-12 rounded-full object-cover shrink-0"
                  width="48"
                  height="48"
                />
              ) : (
                <div
                  class="w-12 h-12 rounded-full flex items-center justify-center shrink-0 text-sm font-semibold"
                  style={`background: ${color}; color: white;`}
                >
                  {initials(name)}
                </div>
              )}
              <div class="text-sm font-semibold" style="color: #374151;">
                {name}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
