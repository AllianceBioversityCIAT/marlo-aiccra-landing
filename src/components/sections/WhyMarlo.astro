---
import ImpactAccordion from './ImpactAccordion.tsx';
import { runtimeEnv } from '../../lib/env';

const videosBaseUrl =
  import.meta.env.PUBLIC_VIDEOS_BASE_URL ??
  runtimeEnv('PUBLIC_VIDEOS_BASE_URL') ??
  '';
---

<section style="background: #f3f4f6;" class="py-24">
  <div class="max-w-[1200px] mx-auto px-6">
    <!-- Header -->
    <div class="text-center mb-12">
      <p class="text-xs font-semibold tracking-widest uppercase mb-3" style="color: #60A5FA;">
        Key Advantages
      </p>
      <h2 class="text-3xl lg:text-4xl font-bold" style="color: #111827;">Why MARLO?</h2>
    </div>

    <ImpactAccordion client:load videosBaseUrl={videosBaseUrl} />
  </div>
</section>
