---
import '../styles/globals.css';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import MicrosoftClarity from '../components/MicrosoftClarity.astro';
import {
  DEFAULT_DESCRIPTION,
  DEFAULT_OG_IMAGE,
  DEFAULT_TITLE,
  SITE_KEYWORDS,
  SITE_NAME,
  SITE_URL,
  absoluteUrl,
  buildJsonLdGraph,
  organizationSchema,
  softwareApplicationSchema,
  webPageSchema,
  websiteSchema,
} from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Open Graph type — usually website */
  ogType?: 'website' | 'article';
  /** Extra Schema.org nodes merged into @graph */
  jsonLd?: Record<string, unknown>[];
  /** When true, exclude from search indexes */
  noindex?: boolean;
}

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  image = DEFAULT_OG_IMAGE,
  ogType = 'website',
  jsonLd = [],
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? SITE_URL);
const canonical = canonicalURL.href;
const ogImage = absoluteUrl(image);
const robots = noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';

const structuredData = buildJsonLdGraph([
  organizationSchema(),
  websiteSchema(),
  softwareApplicationSchema(),
  webPageSchema({
    title,
    description,
    path: Astro.url.pathname,
  }),
  ...jsonLd,
]);
---

<html lang="en" style="background: #012E4A;">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={SITE_KEYWORDS} />
    <meta name="author" content="Alliance of Bioversity International and CIAT — Innovation & Business Development (IBD)" />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#012E4A" />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicons — every entry is the MARLO mark. /favicon.ico stays last so it
         also answers the bare root request browsers make on their own. -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="MARLO" />
    <meta name="application-name" content="MARLO" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="MARLO research management platform dashboard" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="MARLO research management platform dashboard" />

    <!-- GEO: discovery for generative engines -->
    <link rel="alternate" type="text/plain" title="llms.txt" href={absoluteUrl('/llms.txt')} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <GoogleAnalytics />
    <MicrosoftClarity />
  </head>
  <body>
    <slot />
  </body>
</html>
