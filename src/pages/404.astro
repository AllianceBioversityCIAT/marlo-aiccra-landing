---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import { ArrowRight } from '@lucide/astro';
import { navLinks } from '../data/navigation';
---

<!--
  Replaces Astro's built-in 404, which shipped the Astro logo and carried no
  `noindex`. Legacy MARLO application URLs still get requested on this host, so
  this page has to look like MARLO and route people back into the site.
-->
<Layout
  title="Page not found | MARLO"
  description="The page you are looking for is not available on the MARLO platform website."
  noindex={true}
>
  <Navbar />
  <main
    class="flex items-center justify-center px-6 py-24 lg:py-32"
    style="background: #012E4A; min-height: 70vh;"
  >
    <div class="max-w-2xl text-center">
      <p class="text-sm font-semibold tracking-widest uppercase mb-4" style="color: #22D3EE;">
        Error 404
      </p>
      <h1 class="text-4xl lg:text-5xl font-bold text-white leading-tight text-balance">
        This page is not part of the MARLO website
      </h1>
      <p
        class="mt-6 text-base lg:text-lg leading-relaxed"
        style="color: rgba(255,255,255,0.75);"
      >
        The address may be outdated, or it may belong to a MARLO application
        environment rather than to this site. Start from the home page, or jump
        straight to one of the sections below.
      </p>

      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg text-sm font-semibold text-white transition-all"
          style="background-color: #0EA5E9; border: 2px solid #0EA5E9;"
        >
          Go to the home page
          <ArrowRight class="w-4 h-4" />
        </a>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg text-sm font-semibold text-white transition-all"
          style="border: 2px solid rgba(255,255,255,0.35);"
        >
          Contact the MARLO team
        </a>
      </div>

      <nav aria-label="Site sections" class="mt-12">
        <ul class="flex flex-wrap justify-center gap-x-6 gap-y-3">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm underline underline-offset-4 transition-colors"
                  style="color: rgba(255,255,255,0.7);"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </main>
  <Footer />
</Layout>
