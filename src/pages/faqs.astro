---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import FAQsExtended from '../components/sections/FAQsExtended.astro';
import { extendedFaqs } from '../data/faqs';
import { faqPageSchema } from '../lib/seo';
---

<Layout
  title="FAQs | MARLO Research Management & Reporting"
  description="Answers about MARLO for CGIAR and research programs — frameworks, multi-country reporting, integrations, security, scaling, and support."
  jsonLd={[faqPageSchema(extendedFaqs)]}
>
  <Navbar />
  <main>
    <FAQsExtended />
  </main>
  <Footer />
</Layout>
